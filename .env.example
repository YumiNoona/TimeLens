# Vercel server-only variables. Never expose this token to browser code.
# A fine-grained GitHub token needs read-only Contents access to YumiNoona/TimeLens.
GITHUB_TOKEN=
GITHUB_REPOSITORY=YumiNoona/TimeLens
GITHUB_RELEASE_ASSET=TimeLens.exe
# Keep downloads and updates on the production-v3 channel.
GITHUB_RELEASE_MAJOR=3
