<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>8.2.0</Version>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
    <UseWindowsForms>false</UseWindowsForms>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>TimeLens.ico</ApplicationIcon>
    <AssemblyTitle>TimeLens</AssemblyTitle>
    <Product>TimeLens</Product>
    <Company>Veil</Company>
    <Description>TimeLens desktop activity tracker</Description>
    <OutputType>WinExe</OutputType>
    <DebugType>none</DebugType>
    <NoWarn>CA1416</NoWarn>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <SuppressAotAnalysisWarnings>true</SuppressAotAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="TimeLens.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="categories.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SQLite" Version="3.53.4" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeLens.Core\TimeLens.Core.csproj" />
    <ProjectReference Include="..\TimeLens.Api\TimeLens.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\TimeLens.Dashboard\dist\**\*">
      <LogicalName>dashboard/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PkgSQLite)\runtimes\win-x64\native\e_sqlite3.dll">
      <LogicalName>runtime/e_sqlite3.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="categories.csv">
      <LogicalName>runtime/categories.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="TimeLens.ico">
      <LogicalName>runtime/TimeLens.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
