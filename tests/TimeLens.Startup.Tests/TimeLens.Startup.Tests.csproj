<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/TimeLens.TrayApp/RuntimeDiagnostics.cs" Link="RuntimeDiagnostics.cs" />
    <!-- Exercise the production bootstrap without starting watchers or touching user data. -->
    <Compile Include="../../src/TimeLens.TrayApp/Services/DatabaseInitializer.cs" Link="DatabaseInitializer.cs" />
    <Compile Include="../../src/TimeLens.TrayApp/Services/DataRetentionService.cs" Link="DataRetentionService.cs" />
    <Compile Include="../../src/TimeLens.TrayApp/Services/SettingsService.cs" Link="SettingsService.cs" />
    <Compile Include="../../src/TimeLens.TrayApp/Services/AutoStartManager.cs" Link="AutoStartManager.cs" />
    <Compile Include="../../src/TimeLens.Api/AppSettings.cs" Link="AppSettings.cs" />
    <Compile Include="../../src/TimeLens.Api/BlockPresentation.cs" Link="BlockPresentation.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
